{
  "name": "ensemble",
  "private": true,
  "version": "0.1.0",
  "description": "Living Org Canvas — open-source engineering agent workbench",
  "scripts": {
    "dev:canvas": "pnpm --filter @ensemble/canvas dev",
    "build:canvas": "pnpm --filter @ensemble/canvas build",
    "lint:canvas": "pnpm --filter @ensemble/canvas lint",
    "typecheck:canvas": "pnpm --filter @ensemble/canvas typecheck",
    "dev:runtime": "cd services/runtime && .venv/bin/python -m ensemble_runtime",
    "test:runtime": "cd services/runtime && .venv/bin/pytest -q",
    "dev": "echo \"Run: pnpm dev:runtime (terminal A) && pnpm dev:canvas (terminal B)\"",
    "dev:desktop": "pnpm exec tauri dev",
    "build:desktop": "pnpm exec tauri build"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.0",
  "devDependencies": {
    "@tauri-apps/cli": "^2"
  }
}
