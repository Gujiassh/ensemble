{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ensemble",
  "version": "0.1.0",
  "identifier": "dev.ensemble.app",
  "build": {
    "beforeDevCommand": "pnpm --filter @ensemble/canvas dev",
    "devUrl": "http://127.0.0.1:17351",
    "beforeBuildCommand": "pnpm --filter @ensemble/canvas build",
    "frontendDist": "../apps/canvas/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Ensemble",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {}
}
